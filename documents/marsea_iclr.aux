\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Verification of the analytical claims. Denominators are \textbf  {evaluations}, not columns: a column swept at four temperatures contributes four. \textbf  {$^{\dagger }$ marks a row whose conclusion follows from how the generator builds its input}, so it can confirm an algebraic identity but cannot fail --- see App.~\ref {app:numerics}, which says what each of these does and does not test. \textbf  {$^{\ddagger }$ marks a row that re-expresses evaluations already counted} in the Thm.~\ref {thm:recovery} sharpness rows. No column is discarded for failing a claim; rows testing the regime above $1/W_j$ count only the columns for which that regime exists ($W_j>0$), which is why three denominators fall short of the columns drawn. App.~\ref {app:selective} is checked separately in Table~\ref {tab:transferchecks}.}}{37}{table.7}\protected@file@percent }
\newlabel{tab:verification}{{7}{37}{Verification of the analytical claims. Denominators are \textbf {evaluations}, not columns: a column swept at four temperatures contributes four. \textbf {$^{\dagger }$ marks a row whose conclusion follows from how the generator builds its input}, so it can confirm an algebraic identity but cannot fail --- see App.~\ref {app:numerics}, which says what each of these does and does not test. \textbf {$^{\ddagger }$ marks a row that re-expresses evaluations already counted} in the Thm.~\ref {thm:recovery} sharpness rows. No column is discarded for failing a claim; rows testing the regime above $1/W_j$ count only the columns for which that regime exists ($W_j>0$), which is why three denominators fall short of the columns drawn. App.~\ref {app:selective} is checked separately in Table~\ref {tab:transferchecks}}{table.7}{}}
