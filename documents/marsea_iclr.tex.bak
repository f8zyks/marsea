\section{Proofs}
\label{app:proofs}

Every numbered claim in the paper is proved here, in the order it is used in
Sec.~\ref{sec:theory}. Results stated in the main text are \textbf{restated} before their proofs
so this appendix can be read on its own; results the main text gives in prose are stated formally
here for the first time.

Throughout, $\simplex^{n-1}=\{p\in\mathbb{R}^n_{\ge0}:\sum_i p_i=1\}$, and for a vector $z$ we
write $z_{(1)}\ge z_{(2)}\ge\cdots$ for its entries sorted descending. At $\alpha=2$ the solution
of \eqref{eq:program} is $p_{ij}=[\tau_j s_{ij}-\psi_j]_+$ with $\psi_j$ the unique threshold
making the entries sum to one; existence, uniqueness, the sort-based computation and almost-everywhere
differentiability are standard for sparsemax and $\alpha$-entmax
\citep{martins2016softmax,peters2019sparse}, and we use them without reproof.

\begin{lemma}[Prefix property]
\label{lem:prefix}
For $z\in\mathbb{R}^n$ sorted descending let $G(k):=\sum_{r\le k}(z_{(r)}-z_{(k)})$. Then
$G(k{+}1)-G(k)=k(z_{(k)}-z_{(k+1)})\ge0$, so $G$ is non-decreasing; consequently
$\supp(\operatorname{sparsemax}(z))$ is the set of the $k^\star$ largest entries with
$k^\star=\max\{k:G(k)<1\}$, and $\{k:G(k)<1\}$ is a prefix.
\end{lemma}

\begin{proof}[Proof of Lem.~\ref{lem:prefix}]
Write $G(k) = \sum_{r\leq k} z_{(r)} - k z_{(k)}$. Then
\begin{align*}
G(k{+}1) - G(k)
&= \Big(\sum_{r \leq k+1} z_{(r)} - (k{+}1) z_{(k+1)}\Big) - \Big(\sum_{r\leq k} z_{(r)} - k z_{(k)}\Big)\\
&= z_{(k+1)} - (k{+}1)z_{(k+1)} + k z_{(k)}
\;=\; k\big(z_{(k)} - z_{(k+1)}\big) \;\geq\; 0,
\end{align*}
since the entries are sorted descending. Hence $G$ is non-decreasing, and
$\{k : G(k) < 1\}$ is a prefix of $\{1,\dots,n\}$.

For sparsemax, $p = [z - \psi]_+$ with $\sum_i [z_i - \psi]_+ = 1$. If the support consists of
the $k$ largest entries then $\psi = \big(\sum_{r\leq k} z_{(r)} - 1\big)/k$, and $z_{(k)} > \psi$
is equivalent to $k z_{(k)} > \sum_{r\leq k} z_{(r)} - 1$, i.e.\ $G(k) < 1$. The support size
is therefore the largest such $k$, and by the prefix property this is well defined.
\end{proof}

\paragraph{Monotone exclusivity.} Apply Lem.~\ref{lem:prefix} to $z = \tau s$. Since $G$ is
positively homogeneous of degree one, $G_{\tau s}(k) = \tau G_s(k)$ and
$k^\star(\tau) = \max\{k : \tau G_s(k) < 1\}$. As $G_s(k)\ge0$ is non-decreasing in $k$, the set
$\{k : \tau G_s(k) < 1\}$ is nested decreasing in $\tau$, so $k^\star(\tau)$ is non-increasing.
$G_s(1)=0$ always, so $k^\star\ge1$; as $\tau\to0^+$ every $k$ qualifies and $k^\star=n_q$; as
$\tau\to\infty$ only $k$ with $G_s(k)=0$ survive, which holds iff the top $k$ scores are tied,
giving $k^\star\to|\arg\max_i s_i|$.

\medskip\noindent\textbf{Theorem~\ref{thm:separation} (restated).}\ \emph{Fix a key $j$, evaluate a query-local scheme over $\mathcal{D}=\prod_i\mathcal{D}_i$ with
$\{k_j\}$ fixed, and put $\mathcal{R}_i := \{A_{ij}(x_i) : x_i\in\mathcal{D}_i\}$. Then the
attainable set of fan-out columns is exactly the product,
$\{A_{\cdot j}(x) : x\in\mathcal{D}\} = \prod_{i=1}^{n_q}\mathcal{R}_i$, and the scheme satisfies
$A_{\cdot j}\in\mathcal{C}$ for all $x\in\mathcal{D}$ iff $\prod_i\mathcal{R}_i\subseteq\mathcal{C}$.
Hence no query-local scheme enforces a non-product-form $\mathcal{C}$ except vacuously.}

\begin{proof}[Proof of Thm.~\ref{thm:separation}]
($\subseteq$) Fix $x = (x_1,\dots,x_{n_q}) \in \mathcal{D}$. By Def.~\ref{def:qlocal},
$A_{ij}(x) = A_{ij}(x_i)$ for each $i$, so the column
$A_{\cdot j}(x) = \big(A_{ij}(x_i)\big)_{i}$ has $i$-th entry in $\mathcal{R}_i$; hence
$A_{\cdot j}(x) \in \prod_i \mathcal{R}_i$.

($\supseteq$) Let $(a_1,\dots,a_{n_q}) \in \prod_i \mathcal{R}_i$. For each $i$ pick
$x_i \in \mathcal{D}_i$ with $A_{ij}(x_i) = a_i$, which exists by definition of $\mathcal{R}_i$. Because
$\mathcal{D}$ is the \emph{product} $\prod_i \mathcal{D}_i$, the tuple
$x = (x_1,\dots,x_{n_q})$ is admissible, and by query-locality
$A_{\cdot j}(x) = (a_1,\dots,a_{n_q})$.

This proves \eqref{eq:product}. The stated equivalence is immediate: a universally quantified
guarantee over $\mathcal{D}$ holds iff it holds on the attained set, which is exactly
$\prod_i \mathcal{R}_i$. If $\mathcal{C}$ is non-product-form and $\prod_i \mathcal{R}_i \subseteq \mathcal{C}$, then
$\prod_i \mathcal{R}_i$ is a product subset of $\mathcal{C}$; the guarantee is then achieved not by
coupling the entries but by restricting each entry's range independently, which is what we
mean by vacuous.
\end{proof}

\medskip\noindent\textbf{Corollary~\ref{cor:capacity} (restated).}\ \emph{Capacity $\mathcal{C}_{\mathrm{cap}}=\{x:\sum_i x_i\le c\}$ and cardinality
$\mathcal{C}_{\mathrm{card}}=\{x:|\supp(x)|\le m\}$ are non-product-form for $n_q\ge2$, so by
Thm.~\ref{thm:separation} no query-local scheme enforces either, for $c>0$ and $1\le m<n_q$.
The failure is realized on constrained input spaces: given a replication pair $(a,M)$, some
admissible input has $\sum_i A_{ij}\ge Ma$, so capacity fails whenever $c_j<Ma$ and cardinality
whenever $m<M$; with $M=n_q$, no constant budget survives a query set larger than $c_j/a$.}

\begin{proof}[Proof of Cor.~\ref{cor:capacity}]
\emph{Not of product form}, for $c>0$ and $1\le m<n_q$; at $c=0$ or $m\ge n_q$ both sets are
products and the statement is vacuous, which is why those cases are excluded.
Suppose $\mathcal{C}_{\mathrm{cap}} = \prod_i \mathcal{C}_i$ with
$c > 0$ and $n_q \geq 2$. The point $c\,e_1$ (all mass on entry $1$) lies in
$\mathcal{C}_{\mathrm{cap}}$, so $c \in \mathcal{C}_1$; likewise $c \in \mathcal{C}_2$. Then
$c(e_1 + e_2) \in \prod_i \mathcal{C}_i$ but has sum $2c > c$, a contradiction. The same
argument applied to $\mathcal{C}_{\mathrm{card}}$ with $m < n_q$, using two points whose
supports are distinct singletons, gives a product element of support size $2 > m$ when $m=1$,
and generalizes to any $m < n_q$ by taking $m+1$ singletons.

\emph{Violation.} Let $I$ index $M$ coordinates with $\sup \mathcal{R}_i \geq a$. For any
$\epsilon > 0$ choose $x_i \in \mathcal{D}_i$ with $A_{ij}(x_i) > a - \epsilon$ for
$i \in I$, and arbitrary $x_i$ otherwise; admissible because $\mathcal{D}$ is a product. Then
$\sum_i A_{ij} > M(a-\epsilon)$, and letting $\epsilon \to 0$ gives the bound $\geq Ma$. Thus
$\sum_i A_{ij} > c$ once $M > c/a$. For cardinality, the same construction yields at least $M$
strictly positive entries, so $|\supp(A_{\cdot j})| \geq M > m$.

\emph{Realization on constrained domains.} By Assumption~\ref{ass:richness} there is an admissible input with a set
$S \subseteq \{1,\dots,n_q\}$, $|S| \geq M$, on which $A_{ij} \geq a$. Since all entries are
non-negative,
\begin{equation*}
\sum_i A_{ij} \;\geq\; \sum_{i \in S} A_{ij} \;\geq\; |S|\,a \;\geq\; Ma .
\end{equation*}
Hence $\sum_i A_{ij} > c_j$ whenever $c_j < Ma$. The same input has at least $M$ strictly
positive entries in column $j$, so $|\supp(A_{\cdot j})| \geq M > m$ whenever $m < M$. Taking
$M = n_q$ gives $\sum_i A_{ij} \geq n_q a$, which exceeds $c_j$ once $n_q > c_j/a$.
\end{proof}

\medskip\noindent\textbf{Proposition~\ref{prop:conservation} (restated).}\ \emph{If $\sum_j A_{ij}=1$ for every query, then $\max_j \sum_i A_{ij} \ge n_q/n_k$. No
row-normalized scheme can bound every key's fan-out below $n_q/n_k$; doubly stochastic attention
attains this with equality for every key.}

\begin{proof}[Proof of Prop.~\ref{prop:conservation}]
Summing the row constraint over queries gives $\sum_{i,j} A_{ij} = \sum_i 1 = n_q$. A maximum
is at least an average, so
$\max_j \sum_i A_{ij} \geq \frac{1}{n_k}\sum_j\sum_i A_{ij} = n_q/n_k$. For a doubly
stochastic scheme with uniform column marginal every column sums to exactly $n_q/n_k$ by
definition, attaining the bound. Since $n_q/n_k \to \infty$ as $n_q$ grows with $n_k$ fixed,
no constant bound on all columns is possible.

The restriction to \emph{all} columns is essential. A row-normalized scheme may bound one
column --- e.g.\ by driving $s_{ij}\to-\infty$ for a single $j$ --- whereupon the remaining
columns absorb the mass. Cor.~\ref{cor:capacity} excludes this for query-local schemes on
different grounds, namely that the bound must hold uniformly over admissible inputs.
\end{proof}

\begin{proposition}[Every competitive selection is realizable]
\label{prop:realizability}
Let $\{T_j\}$ partition $\{1,\dots,n_q\}$ with $m_j=|T_j|\ge1$. Then scores, exclusivities,
a relation $\mathcal{E}$ exist such that, with capacities inherited by \eqref{eq:step1},
$\supp(A_{\cdot j})=T_j$ at every admissible $\tau_i$, for every $j$
simultaneously; the construction survives any sup-norm score perturbation below $1/2$. The
cardinalities may differ arbitrarily subject only to what a partition forces,
$\sum_j m_j = n_q$: scope $1$ and scope $n_q-n_k+1$ coexist in one realization.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:twostep}]
(i) By \eqref{eq:step1}, $\tilde A_{ij}=A^{\mathrm{sm}}_{ij}$ off $\mathcal{E}_{\cdot j}$ and
$\sum_{i\in\mathcal{E}_{\cdot j}}\tilde A_{ij}=\bar c_j\sum_i p_{ij}=\bar c_j$ since $p_{\cdot j}$ lies
on the simplex; so $\sum_i\tilde A_{ij}=\bar c_j+\sum_{i\notin\mathcal{E}_{\cdot j}}A^{\mathrm{sm}}_{ij}
=\sum_iA^{\mathrm{sm}}_{ij}=c_j$. (ii) Summing (i) over $j$ and exchanging sums,
$\sum_jc_j=\sum_i\sum_jA^{\mathrm{sm}}_{ij}=\sum_i1=n_q$. (iii) Step 1 of Stage 2 is a
projection onto $\{a\ge0:\sum_ja_j\le\sum_jA^{\mathrm{sm}}_{ij}\}$, which is the unit cap since
the row-softmax row sums to one, so $\sum_ja^{(1)}_{ij}\le\sum_jA^{\mathrm{sm}}_{ij}$; step 2 replaces the
relation's entries by $\tau_iu$ with $\sum_{j\in\mathcal{E}_{i\cdot}}\tau_iu_j\le \bar c_i
=\sum_{j\in\mathcal{E}_{i\cdot}}a^{(1)}_{ij}$ and leaves the rest, so the row total does not
increase. (iv) Off $\mathcal{E}_{\cdot j}$ step 2 of Stage 1 does not write; off
$\mathcal{E}_{i\cdot}$ step 2 of Stage 2 does not write. (v) The step-2 program is the projection
of $\tilde A_{i\mathcal{E}_{i\cdot}}\ge0$ onto $\{u\ge0:\sum u\le \bar c_i/\tau_i\}$. If the
constraint is slack the projection is the identity on the non-negative orthant and
$\theta_i=0$; if it binds, the KKT conditions give $u_j=[\tilde A_{ij}-\theta_i]_+$ with
$\theta_i$ the multiplier of an \emph{inequality}, hence $\theta_i\ge0$. In either case
$\tilde A_{ij}=0\Rightarrow u_j=0$, and $\sum_{j\in\mathcal{E}_{i\cdot}}A_{ij}\le \bar c_i$. (vi) With
$\mathcal{E}=\emptyset$ no step 2 runs on either margin, $\tilde A=A^{\mathrm{sm}}$, and step 1 of
Stage 2 projects a row already summing to one onto the unit cap, which fixes it.
\end{proof}

\begin{proof}[Proof of Prop.~\ref{prop:scopemono}]
$W_j$ and $m_j$ are functions of $\{s_{ij}:i\in T_j\}$ alone and $T_j$ is common to both sets.
(i) $\delta_j(\mathcal{E})=\min_{T_j}s-\max_{\mathcal{E}\setminus T_j}s$ and
$\mathcal{E}'\setminus T_j\subseteq\mathcal{E}\setminus T_j$, so the maximum over the smaller
set is no larger. (ii) Immediate from (i) with $W_j,m_j$ fixed. (iii) If
$\delta_j(\mathcal{E})>0$ then $\delta_j(\mathcal{E}')\ge\delta_j(\mathcal{E})>0$, so
Assumption~\ref{ass:margin} holds on $\mathcal{E}'$; the lower endpoint $1/(W_j+m_j\delta_j)$ is
decreasing in $\delta_j$ and the upper endpoint $1/W_j$ does not depend on the set, giving
$[1/(W_j+m_j\delta_j(\mathcal{E})),1/W_j)\subseteq[1/(W_j+m_j\delta_j(\mathcal{E}')),1/W_j)$.
(iv) Take $T_j=\{1\}$, $\mathcal{E}'=\{1,2\}$, $\mathcal{E}=\{1,2,3\}$ with
$s_1=1,s_2=0,s_3=2$: then $\delta_j(\mathcal{E}')=1>0>-1=\delta_j(\mathcal{E})$.
\end{proof}

\begin{proof}[Proof of Prop.~\ref{prop:realizability}]
Take $s_{ij} = \mathbb{1}[i \in T_j]$. Fix $j$. Since the $T_j$ are non-empty, every target in
$T_j$ scores $1$ and every other query scores $0$, so
$\delta_j = 1 - 0 = 1 > 0$ and, all scores within $T_j$ being equal,
$W_j = \sum_{i \in T_j}(1 - 1) = 0$. By Thm.~\ref{thm:recovery} the recovery interval is
$[1/(W_j+m_j \delta_j), 1/W_j) = [1/m_j, \infty)$, which is non-empty; choose any $\tau_j$ in it.
Then $\supp(p_{\cdot j}) = T_j$, and because the program \eqref{eq:program} is symmetric under
permutation of equally scored coordinates and its solution is unique
\citep{martins2016softmax}, $p_{\cdot j}$ is uniform on $T_j$: $p_{ij} = 1/m_j$ for
$i \in T_j$ and $0$ otherwise.

Setting $c_j = m_j$ gives $\tilde A_{ij} = m_j \cdot (1/m_j) = 1$ for $i \in T_j$ and $0$
otherwise. Because $\{T_j\}$ partitions $\{1,\dots,n_q\}$ we have
$\sum_j c_j = \sum_j m_j = n_q$, so the construction also honours the budget normalization of
Sec.~\ref{sec:method-fanout}; the conclusion does not depend on it, since only $c_j>0$ is used.
Each row of $\tilde A$ then has exactly one non-zero entry, equal to $1$, so \eqref{eq:rowprog}
gives $A_{ij} = \min(\tau_i,1) > 0$ for the unique $j$ with $i \in T_j$ --- the cap slack at
$\tau_i\le1$, binding at $\tau_i>1$ with $\theta_i = 1-1/\tau_i$ --- and $A_{ij} = 0$ otherwise.
This is the claimed realization, at every admissible $\tau_i$; note $\theta_i$ is not a free
witness, being the dual of a cap fixed at one.

For robustness, let $s'$ satisfy $\|s' - s\|_\infty < 1/2$. Then for each $j$ every target
still scores above $1/2$ and every non-target below $1/2$, so $\delta'_j > 0$ and the top $m_j$
entries of $s'_{\cdot j}$ remain $T_j$. Assumption~\ref{ass:margin} therefore still holds and
Thm.~\ref{thm:recovery} applies with the perturbed constants, so
$\supp(\tilde A_{\cdot j}) = T_j$ persists for every $\tau_j$ in the corresponding interval.

Finally, on cardinalities: the partition is used twice above --- to give $\sum_j c_j=n_q$, and to
make each row of $\tilde A$ carry exactly one non-zero --- so the $m_j$ are constrained by
$\sum_j m_j = n_q$ and by nothing else. Since each $m_j \ge 1$, one key may take
$n_q-n_k+1$ targets while the rest take one apiece, which is the widest spread a partition
permits. Dropping the partition to arbitrary non-empty $\{T_j\}$ removes even that constraint at
the cost of a longer Stage-2 step: a row with $r>1$ unit-valued entries gives
$\theta_i = 1 - 1/(r\tau_i)$ when the cap binds and all $r$ survive, so the conclusion is
unchanged.
\end{proof}

\begin{proposition}[Selection is local; scope-respecting selection is not]
\label{prop:scope}
Fix a query-local scheme. \textbf{(i)} Selection at a \emph{single} target is available to it:
row-sparsemax at large temperature admits only $\arg\max_j s_{ij}$ at every target.
\textbf{(ii)} Scope is not: for a scope bound $\kappa_j$ (the requirement being
$|T_j|\le\kappa_j$), a replication pair $(a,M)$ with $\kappa_j<M$ drives
$|\supp(A_{\cdot j})|\ge M>\kappa_j$ on some admissible input. \textbf{(iii)} Hence the non-local content is
neither in isolation but their \emph{conjunction}, which MarSea satisfies by construction.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:scope}]
(i) Let $A_{i\cdot} := \operatorname{sparsemax}(\lambda\, s_{i\cdot})$ for $\lambda > 0$. This
is query-local: the row depends on $q_i$, $\gamma_{i\cdot}$ and $\{k_j\}_j$ only, and on no
$x_{i'}$ with $i' \neq i$. By monotone exclusivity applied along the row,
$|\supp(\operatorname{sparsemax}(\lambda s_{i\cdot}))| \to |\arg\max_j s_{ij}|$ as
$\lambda \to \infty$, which is $1$ for scores in general position; and by
Lem.~\ref{lem:prefix} the surviving index is the largest, namely $\arg\max_j s_{ij}$. Choosing
$\lambda$ beyond the finite threshold at which the support size reaches its limit gives the
claim.

(ii) By Assumption~\ref{ass:richness} there is an admissible input on which at least $M$
queries satisfy $A_{ij} \ge a > 0$; each such query contributes a strictly positive entry to
column $j$, so $|\supp(A_{\cdot j})| \ge M$. If $\kappa_j < M$ this violates
$|T_j| \le \kappa_j$. The argument is the cardinality half of Cor.~\ref{cor:capacity} and
holds for every query-local scheme admitting a replication pair.

(iii) Immediate from (i) and (ii): the class attains target-side exclusivity, fails scope, and
therefore fails their conjunction. MarSea attains the conjunction. Realizability is
Prop.~\ref{prop:realizability}. For scope, the relevant quantity is a \emph{cardinality}, and
Lem.~\ref{lem:prefix} supplies it directly: $|\supp(\tilde A_{\cdot j})| = k^\star(\tau_j)$,
which by monotone exclusivity is non-increasing in $\tau_j$ and equals $m_j$ under
Assumption~\ref{ass:margin} with $\tau_j$ in \eqref{eq:interval}. Since $\tau_i>0$ and
$\theta_i\ge0$ give $A_{ij}>0 \Rightarrow \tilde A_{ij}>\theta_i$, we have
$\supp(A_{\cdot j})\subseteq\supp(\tilde A_{\cdot j})$ and hence
$|\supp(A_{\cdot j})|\le k^\star(\tau_j)$, with no appeal to $c_j$ and no bound on $\tau_i$
required. (The \emph{mass} statement $\sum_i \tilde A_{ij} = c_j\sum_i p_{ij} = c_j$ also holds
by \eqref{eq:program}, giving $|\{i : \tilde A_{ij} \ge t\}| \le c_j/t$ by Markov; it is stated
on the Stage-1 output because $A_{ij} = \tau_i[\tilde A_{ij}-\theta_i]_+$ need not satisfy
$A_{ij}\le\tilde A_{ij}$ when $\tau_i>1$. That statement is not what (iii) needs.)
\end{proof}

\medskip\noindent\textbf{Theorem~\ref{thm:recovery} (restated).}\ \emph{Let $\alpha=2$ and Assumption~\ref{ass:margin} hold. Then $\supp(\tilde A_{\cdot j}) = T_j$
if and only if $\tau_j \in [\,1/(W_j+m_j\delta_j),\ 1/W_j\,)$, with $1/W_j := \infty$ when
$W_j=0$; this interval is non-empty for every column with a positive margin.}

\begin{proof}[Proof of Thm.~\ref{thm:recovery}]
Let $z := \tau_j s_{\cdot j}$ with $\tau_j > 0$. By Assumption~\ref{ass:margin},
$\min_{i\in T_j} s_{ij} > \max_{i \notin T_j} s_{ij}$, so the $m_j$ largest entries of $z$ are
exactly the indices in $T_j$. Write $G$ for the quantity in Lem.~\ref{lem:prefix} applied to
$z$, and recall from that lemma that the support of $\operatorname{sparsemax}(z)$ is the top
$k^\star$ entries with $k^\star = \max\{k : G(k) < 1\}$. It therefore suffices to show
$k^\star = m_j$.

\emph{Step 1: $k^\star \geq m_j$, i.e.\ $G(m_j) < 1$.} By definition,
\begin{equation*}
G(m_j) \;=\; \sum_{r \leq m_j}\big(z_{(r)} - z_{(m_j)}\big)
\;=\; \tau_j \sum_{i \in T_j}\Big(s_{ij} - \min_{i' \in T_j} s_{i'j}\Big) \;=\; \tau_j W_j ,
\end{equation*}
using that the top $m_j$ entries are $T_j$ and that $z_{(m_j)}$ corresponds to the smallest
score within $T_j$. Hence $G(m_j) < 1$ iff $\tau_j W_j < 1$ iff $\tau_j < 1/W_j$: an
\emph{equivalence}, not merely a sufficient condition.

\emph{Step 2: $k^\star \leq m_j$, i.e.\ $G(m_j{+}1) \geq 1$.} The top $m_j$ entries are $T_j$
and $z_{(m_j+1)}$ corresponds to the largest score outside $T_j$, which by
Assumption~\ref{ass:margin} is $\min_{i\in T_j}s_{ij}-\delta_j$. So $G(m_j{+}1)$ is not merely
bounded below but \emph{available in closed form}: writing $s_{\min}:=\min_{i\in T_j}s_{ij}$,
\begin{equation*}
G(m_j{+}1) \;=\; \sum_{r \leq m_j}\big(z_{(r)} - z_{(m_j+1)}\big)
\;=\; \tau_j\Big(\sum_{i\in T_j}\big(s_{ij}-s_{\min}\big) + m_j\delta_j\Big)
\;=\; \tau_j\big(W_j + m_j\delta_j\big) ,
\end{equation*}
the $r=m_j{+}1$ term vanishing. Hence $G(m_j{+}1)\ge1$ iff $\tau_j \ge 1/(W_j+m_j\delta_j)$,
again an equivalence.

By Lem.~\ref{lem:prefix} the feasible set $\{k : G(k) < 1\}$ is a prefix, so
$G(m_j{+}1) \geq 1$ implies $G(k) \geq 1$ for all $k \geq m_j{+}1$ and hence
$k^\star \leq m_j$. Combining the two steps, $k^\star = m_j$ --- and the support is $T_j$ ---
exactly when $\tau_j$ lies in \eqref{eq:interval}. Finally that interval is non-empty iff
$W_j < W_j + m_j\delta_j$, i.e.\ iff $m_j\delta_j>0$, which Assumption~\ref{ass:margin} and
$m_j\ge1$ give (interpreting $1/0 = \infty$).

\emph{Remark.} Bounding $G(m_j{+}1)\ge m_j\tau_j\delta_j$ instead yields the sufficient interval
$[1/(m_j\delta_j),1/W_j)$, which is non-empty only when $m_j\delta_j>W_j$; that condition is an
artifact of the bound and not a property of the problem.
\end{proof}

\begin{corollary}[Content-dependent exclusivity is necessary]
\label{cor:necessity}
If two keys satisfy $W_{j_2}+m_{j_2}\delta_{j_2}\le W_{j_1}$ their recovery intervals are
disjoint, so no single global $\tau$ achieves exact recovery for both; a content-predicted
$\tau_j$ does.
\end{corollary}

\begin{proof}[Proof of Cor.~\ref{cor:necessity}]
Let $I_{j} := \big[1/(W_j+m_j\delta_j),\, 1/W_j\big)$, which by Thm.~\ref{thm:recovery} is
\emph{exactly} the set of temperatures recovering key $j$. The hypothesis
$W_{j_2}+m_{j_2}\delta_{j_2} \leq W_{j_1}$ gives
$\sup I_{j_1}=1/W_{j_1} \leq 1/(W_{j_2}+m_{j_2}\delta_{j_2})=\inf I_{j_2}$, and since $I_{j_1}$
is open on the right, $I_{j_1} \cap I_{j_2} = \emptyset$. A single global temperature lies in at
most one of the two sets, so --- because Thm.~\ref{thm:recovery} is an equivalence and not
merely a sufficient condition --- exact recovery genuinely fails for at least one of the two
keys. A per-key $\tau_j$ can be chosen in each interval separately.
\end{proof}

\begin{proposition}[The precision ceiling of full support]
\label{prop:fullsupportceiling}
Let a mechanism assign $p_{ij}>0$ to every pair --- row-softmax, any additive bias on it, any
elementwise gate with positive factors. Then for every key, every score configuration and every
temperature, $P_j = m_j/n_q$ on every column and $P_i = |K_i|/n_k$ on every row. Both are
independent of the scoring function, so neither improves by training, by architecture within the
class, or by any temperature; both tend to $0$ as the candidate set grows. Recall is $1$
trivially.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:fullsupportceiling}]
If $p_{ij} > 0$ for every $i$ then $S_j = \supp(p_{\cdot j}) = \{1,\dots,n_q\}$, so
$|S_j| = n_q$ and $|S_j \cap T_j| = |T_j| = m_j$, giving $P_j = m_j/n_q$ by
Def.~\ref{def:fidelity}. Neither quantity refers to the scores, so the value is unchanged by any
reparameterization of the scoring function or any positive temperature; row-softmax has
$p_{ij} = e^{s_{ij}}/\sum_{i'}e^{s_{i'j}} > 0$ for all finite scores, and an elementwise gate
with positive factors preserves positivity. The row statement is identical with the margins
exchanged. Finally $m_j/n_q \to 0$ as $n_q \to \infty$ at fixed $m_j$.
\end{proof}

\begin{proposition}[The recovery interval is a precision--recall interval]
\label{prop:printerval}
The endpoints of \eqref{eq:interval} govern the two error types separately, and each is an
equivalence: $\tau_j \ge 1/(W_j+m_j\delta_j)$ is exactly the \textbf{precision} requirement
($P_j=1$ iff it holds, and below it $P_j<1$ with $R_j=1$) and $\tau_j < 1/W_j$ exactly the
\textbf{recall} requirement ($R_j=1$ iff it holds, and above it $R_j<1$ with $P_j=1$), with
$P_j=R_j=\rho_j=1$ inside. Since the interval is always non-empty, both are attainable at a
single temperature on \emph{every} column with a positive margin; what a hard column costs is
not attainability but the \emph{width} $m_j\delta_j/W_j$ of the target the head must hit.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:printerval}]
Write $G$ for the prefix statistic of Lem.~\ref{lem:prefix} applied to $z = \tau_j s_{\cdot j}$
and recall $k^\star = \max\{k : G(k) < 1\}$, with $\supp = $ the top $k^\star$ entries.

(i) Step~2 of the proof of Thm.~\ref{thm:recovery} computes $G(m_j{+}1)=\tau_j(W_j+m_j\delta_j)$
exactly, so $k^\star \leq m_j$ iff $\tau_j \geq 1/(W_j+m_j\delta_j)$. If instead
$\tau_j < 1/(W_j+m_j\delta_j)$ then $G(m_j{+}1)<1$, so $k^\star > m_j$ and the support strictly
contains $T_j$; since by Assumption~\ref{ass:margin} the entries ranked beyond $m_j$ lie outside
$T_j$, we get $|S_j| > m_j = |S_j \cap T_j|$ and hence $P_j < 1$, while $R_j = 1$. No extremal
configuration is needed: the equivalence holds for every column.

(ii) Step~1 establishes $k^\star \geq m_j$ from $G(m_j) = \tau_j W_j < 1$, i.e.\
$\tau_j < 1/W_j$. If $\tau_j \geq 1/W_j$ then $G(m_j) \geq 1$, so $k^\star < m_j$ and the
support is a proper subset of the top $m_j$ entries, which are exactly $T_j$; hence
$|S_j \cap T_j| = |S_j| < m_j$, giving $R_j < 1$ with $P_j = 1$.

Combining, both equal one simultaneously iff $\tau_j$ lies in
$[1/(W_j+m_j\delta_j), 1/W_j)$, which is non-empty whenever $\delta_j>0$.

\emph{Exactness inside the interval.} By Thm.~\ref{thm:recovery}, $S_j = \supp(p_{\cdot j}) = T_j$ for every $\tau_j$ in
\eqref{eq:interval}. Then $|S_j \cap T_j| = |T_j| = m_j = |S_j|$, so
$P_j = R_j = 1$ by Def.~\ref{def:fidelity}. Every coordinate outside $T_j$ is exactly zero, so
$\rho_j = \sum_{i \in T_j} p_{ij} = \sum_i p_{ij} = 1$.
\end{proof}

\begin{proposition}[Graded degradation, both margins, weakest-first]
\label{prop:graded}
Past the upper endpoint of its interval each margin sheds true members in \emph{non-decreasing}
order of strength --- one at a time except that tied members shed together --- with precision
pinned at $1$ throughout. \textbf{(i)} For
$\tau_j>1/W_j$, $P_j=1$ and $R_j=k(\tau_j)/m_j$ with $k(\tau_j)=\max\{k : W_j(k)<1/\tau_j\}$,
$W_j(k):=\sum_{r\le k}(s_{(r)}-s_{(k)})$. \textbf{(ii)} If the row separates, any
$\theta_i\in[\max_{j\notin K_i}\tilde A_{ij},\ \min_{j\in K_i}\tilde A_{ij})$ gives $P_i=R_i=1$,
and above it $P_i=1$ with $R_i=k(\theta_i)/|K_i|$, where
$k(\theta_i):=|\{j\in K_i : \tilde A_{ij}>\theta_i\}|$ counts the true sources still above the
floor. The two margins are driven by different
heads, $\tauK$ directly and $\tauQ$ through the dual $\theta_i$, reading different fields and
aimed at these two different intervals, and are separately diagnosable. The row interval is
reachable only through $\tau_i$, $\theta_i$ being a dual and not a knob (App.~\ref{app:limitations}).
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:graded}]
\emph{(i) Column.} Let $\tau_j > 1/W_j$. By part (ii) of the previous proof $k^\star < m_j$, so the support is
contained in the top $m_j$ entries, which by Assumption~\ref{ass:margin} are exactly $T_j$;
hence $S_j \subseteq T_j$, giving $P_j = 1$ and $R_j = |S_j|/m_j = k^\star/m_j$. For
$k \leq m_j$ the top $k$ entries all lie in $T_j$, so
$G(k) = \tau_j \sum_{r\leq k}(s_{(r)} - s_{(k)}) = \tau_j W_j(k)$, and
$k^\star = \max\{k : \tau_j W_j(k) < 1\} = \max\{k : W_j(k) < 1/\tau_j\}$, which is the
claimed $k(\tau_j)$. Monotonicity of $W_j(k)$ in $k$ is Lem.~\ref{lem:prefix}, so the
surviving set is a prefix in score order and the lowest-scoring targets are shed first.

\emph{(ii) Row.} Write $\mu := \max_{j \notin K_i}\tilde A_{ij}$ and $\lambda := \min_{j \in K_i}\tilde A_{ij}$,
with $\mu < \lambda$ by hypothesis. For $\theta_i \in [\mu, \lambda)$ and $j \in K_i$ we have
$\tilde A_{ij} \geq \lambda > \theta_i$, so $A_{ij} > 0$; for $j \notin K_i$ we have
$\tilde A_{ij} \leq \mu \leq \theta_i$, so $A_{ij} = \tau_i[\tilde A_{ij}-\theta_i]_+ = 0$. Hence
$\supp(A_{i\cdot}) = K_i$ and both row precision and row recall equal $1$.

For monotonicity, $\theta \mapsto \{j : \tilde A_{ij} > \theta\}$ is nested decreasing, so
recall is non-increasing. For precision, the surviving set is always a top set in the order
induced by $\tilde A_{i\cdot}$; because that order places every element of $K_i$ above every
element of its complement, each element removed as $\theta_i$ increases is drawn from the
complement until the complement is exhausted, and only then from $K_i$. Precision is therefore
non-decreasing until it reaches $1$ and constant at $1$ thereafter.

For the \emph{rate}, let $\theta_i \geq \lambda$. Every surviving coordinate satisfies
$\tilde A_{ij}>\theta_i\ge\lambda=\min_{j\in K_i}\tilde A_{ij}$, and by separation every
coordinate outside $K_i$ is at most $\mu\le\lambda$, so $S_i\subseteq K_i$ and $P_i=1$; hence
$|S_i\cap K_i|=|S_i|=|\{j\in K_i:\tilde A_{ij}>\theta_i\}|=k(\theta_i)$ and
$R_i=k(\theta_i)/|K_i|$, which is the claim. Coordinates leave in non-decreasing order of
$\tilde A_{ij}$ and tied coordinates leave together, since the surviving set is a superlevel set
of $\tilde A_{i\cdot}$; the same remark applies to $k(\tau_j)$ in (i), where a tie at rank $k$
makes $W_j(k)=W_j(k{+}1)$ and $k^\star$ falls by more than one.

Note finally that $\theta_i$ is not free: it is the dual of the unit cap, so as $\tau_i$ ranges
over $(0,\infty)$ the floor traverses $[0,\max_j\tilde A_{ij})$ continuously and strictly
increasingly, and the interval above is reachable iff it meets that range
(App.~\ref{app:limitations}).
\end{proof}

\begin{proposition}[Composition of the two stages]
\label{prop:stagecomp}
For every $\theta_i \ge 0$: \textbf{(i)} $S_j^{(2)}\subseteq S_j^{(1)}$, so Stage 2 can only lose
recall. \textbf{(ii)} If $P_j^{(1)}=1$ then $P_j^{(2)}=1$ \emph{unconditionally}, for any
admission floors whatsoever. \textbf{(iii)} If $P_j^{(1)}<1$, Stage 2 may raise precision ---
and may also lower it, since $\theta_i$ is indexed by the row while $P_j$ is a column quantity.
\textbf{(iv)} A Stage-1 false negative is \textbf{unrecoverable}: $\tilde A_{ij}=0$ implies
$A_{ij}=0$ for every $\theta_i\ge0$. Statements (i), (ii) and (iv) hold verbatim on the row
margin. So does (iii)'s conclusion, but not its reason: on the row $\theta_i$ and $P_i$ are both
row quantities, and precision falls there when a floor common to the row removes a weak true
source before a strong false one.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:stagecomp}]
(i) $A_{ij} = \tau_i[\tilde A_{ij} - \theta_i]_+$ with $\tau_i>0$ and $\theta_i \geq 0$, so
$A_{ij} > 0$ requires $\tilde A_{ij} > \theta_i \geq 0$; hence
$S_j^{(2)} \subseteq S_j^{(1)}$. Intersecting with $T_j$ and dividing by the constant $m_j$,
$|S_j^{(2)} \cap T_j| \leq |S_j^{(1)} \cap T_j|$ gives $R_j^{(2)} \leq R_j^{(1)}$.

(ii) $P_j^{(1)} = 1$ means $S_j^{(1)} \subseteq T_j$. By (i),
$S_j^{(2)} \subseteq S_j^{(1)} \subseteq T_j$, so $|S_j^{(2)} \cap T_j| = |S_j^{(2)}|$ and
$P_j^{(2)} = 1$, vacuously so on an empty support by the convention of
Def.~\ref{def:fidelity}. Nothing in the argument constrains
$\theta_i$, which is the content of the ``unconditionally''.

(iii) For $i \notin T_j$ with $\tilde A_{ij} > 0$, the edge survives iff
$\tilde A_{ij} > \theta_i$, so it is removed exactly when $\tilde A_{ij} \leq \theta_i$.
Whether $P_j^{(2)}$ then exceeds $P_j^{(1)}$ depends on how many true edges are removed
alongside; shrinking a support raises precision only when the removals are disproportionately
false, which is why the statement is a ``may'' and not an inequality.

(iv) If $\tilde A_{ij} = 0$ then $A_{ij} = \tau_i[0 - \theta_i]_+ = 0$ for every
$\theta_i \geq 0$: the map $x \mapsto \tau_i[x-\theta]_+$ is non-decreasing and fixes $0$, so no
admission floor can raise a zero.

The row statements are the same computation with the roles of the indices exchanged; (i)--(iv)
used only that truncation is coordinatewise, monotone, and fixes $0$. In particular the gain
$\tau_i>0$ enters none of them: it rescales surviving entries and moves no support.
\end{proof}

\begin{proposition}[A smooth column dilutes with the candidate set]
\label{prop:leakage}
Suppose the fan-out were computed by column-\emph{softmax} and let Assumption~\ref{ass:margin}
hold. Then the mass outside the target set relative to that inside obeys
$\sum_{i \notin T_j} p_{ij}\,/\sum_{i \in T_j} p_{ij} \leq \frac{n_q - m_j}{m_j} e^{-\tau_j
\delta_j}$, so $\tau_j \geq \frac{1}{\delta_j}\log\frac{n_q - m_j}{m_j\varepsilon}$ \emph{suffices}
to hold the ratio at $\varepsilon$; and the bound is attained with equality --- so that
temperature is also \emph{required} --- whenever the non-targets tie at $\max_{i\notin T_j}s_{ij}$
and the targets at $\min_{i\in T_j}s_{ij}$. The requirement therefore grows like $\log n_q$ in the
worst case over configurations meeting Assumption~\ref{ass:margin}, whereas exact recovery at
$\alpha=2$ needs only $\tau_j \ge 1/(W_j+m_j\delta_j)$, in which $n_q$ does not appear.
App.~\ref{app:selective} reads the comparison honestly: $n_q$ survives inside $\delta_j$ on both
sides, so the residual difference is the logarithmic factor.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:leakage}]
By Assumption~\ref{ass:margin}, $s_{ij} \leq \max_{i' \notin T_j} s_{i'j}$ for every
$i \notin T_j$ and $s_{ij} \geq \min_{i' \in T_j} s_{i'j}$ for every $i \in T_j$, and these two
quantities differ by $\delta_j$. The normalizing constant cancels in the ratio, so
\begin{equation*}
\frac{\sum_{i \notin T_j} e^{\tau_j s_{ij}}}{\sum_{i \in T_j} e^{\tau_j s_{ij}}}
\;\leq\; \frac{(n_q - m_j)\,\exp\!\big(\tau_j \max_{i \notin T_j} s_{ij}\big)}
{m_j\,\exp\!\big(\tau_j \min_{i \in T_j} s_{ij}\big)}
\;=\; \frac{n_q - m_j}{m_j}\,e^{-\tau_j \delta_j},
\end{equation*}
using $\tau_j > 0$ and the definition of $\delta_j$, which is the stated bound. Setting the
right-hand side to $\varepsilon$ and solving for $\tau_j$ gives a \emph{sufficient} temperature,
since the criterion was reached from an upper bound. It is also necessary in the worst case:
if every non-target sits at $\max_{i\notin T_j}s_{ij}$ and every target at
$\min_{i\in T_j}s_{ij}$, both inequalities above hold with equality, the ratio is exactly
$\frac{n_q-m_j}{m_j}e^{-\tau_j\delta_j}$, and no smaller $\tau_j$ holds it at $\varepsilon$. This
is the configuration the $\log n_q$ claim is about; on configurations with the non-targets spread
well below their maximum a smaller $\tau_j$ suffices. The comparison with
Thm.~\ref{thm:recovery} is immediate either way, that bound being
$\tau_j \geq 1/(W_j+m_j\delta_j)$ with no dependence on $n_q$.
\end{proof}

\begin{proposition}[Exactness of hierarchical selection, and fidelity under retention]
\label{prop:tournament}
Let $k^\star=|\supp(\operatorname{sparsemax}(\tau_j s_{\cdot j}))|$.
\textbf{(i)} If $K\ge k^\star$, hierarchical top-$K$ retention followed by one exact program on
the survivors yields $p_{\cdot j}$ identical to the global solution, for any block size and merge
arity. \textbf{(ii)} If Assumption~\ref{ass:margin} holds with $\tau_j$ in \eqref{eq:interval}
and $K<m_j$, the surviving support is the $K$ highest-scoring members of $T_j$, whence $P_j=1$,
$R_j=K/m_j$ and $\rho_j=1$: under-retention is a \emph{pure recall} failure, exact in rate ---
and invisible to $\rho_j$.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:tournament}]
\emph{(i) Exactness.} By Lem.~\ref{lem:prefix} the support of $\operatorname{sparsemax}(z)$ is the set of the
$k^\star$ largest entries of $z$, and the solution on that set is $p_i = z_i - \psi$ with
$\psi$ determined by those entries alone. It therefore suffices that no member of the global
top-$k^\star$ is discarded at any level, since the root program then sees a superset of the
global support and reproduces both $k^\star$ and $\psi$.

Retention is by score order within each group, so a member of the global top-$k^\star$ is
discarded at some level only if more than $K$ entries of that group outrank it; every such
entry is then also globally ranked above it, hence itself a member of the global top-$k^\star$,
giving more than $K$ members of a set of size $k^\star$ and so $K < k^\star$. Contrapositively,
$K \geq k^\star$ implies no member is ever discarded, at any level and for any block size or
merge arity. The root group receives every survivor, and solving the program there over a
superset of the global support returns the global $p_{\cdot j}$ exactly, the coordinates
outside the support being zero in both.

\emph{(ii) Under-retention.} Here $k^\star = m_j$, since Assumption~\ref{ass:margin} with
$\tau_j$ in \eqref{eq:interval} gives $\supp(p_{\cdot j}) = T_j$ by Thm.~\ref{thm:recovery};
so $K<m_j$ means $K<k^\star$ and part (i) does not apply. What does still apply is the
\emph{retention} argument used inside (i): retention is by score order at every level, and a
globally top-$K$ entry is discarded only if more than $K$ entries of its group outrank it, each
of which is then itself globally top-$K$ --- impossible. So the survivor set is exactly the $K$
globally highest-scoring entries.

By Assumption~\ref{ass:margin} the top $m_j$ entries are $T_j$, so for $K < m_j$ the survivor set
is the $K$ highest-scoring members of $T_j$ (ties at rank $K$ broken arbitrarily, the conclusion
being unaffected). Solving the program on that set: writing $G$ for
the statistic of Lem.~\ref{lem:prefix}, $k^\star = m_j$ means $G(k) < 1$ for every
$k \leq m_j$, hence in particular for every $k \leq K$; and $G$ restricted to the survivors
agrees with the global $G$ for $k \le K$, since $G(k)$ depends only on the top $k$ entries, which
are the same in both. So the support is all $K$ survivors.
Therefore $S_j$ is a subset of $T_j$ of size $K$, giving $|S_j \cap T_j| = |S_j| = K$ and so
$P_j = 1$ and $R_j = K/m_j$ by Def.~\ref{def:fidelity}. Finally the allocation is normalized over
the survivors, all of which lie in $T_j$, so $\rho_j = \sum_{i \in T_j} p_{ij} = 1$.
\end{proof}

\begin{proposition}[Prefix monotonicity: growth is edge-removing]
\label{prop:prefix}
Let $\psi_j^{(t)}$ be the Stage-1 threshold on the visible set $Q_j(t)$, at fixed $\tau_j$. Then
\textbf{(i)}
$\psi_j^{(t)}$ is non-decreasing in $t$; \textbf{(ii)} exclusion is permanent ($p_{ij}^{(t)}=0$
implies $p_{ij}^{(t')}=0$ for $t'\ge t$) while admission is provisional; \textbf{(iii)} the
frozen-prefix variant over-admits and never under-admits, so its error is one-sided.
\end{proposition}

\begin{proof}[Proof of Prop.~\ref{prop:prefix}]
(i) At $\alpha = 2$ the threshold $\psi$ is the unique solution of
$\sum_{i \in Q}[z_i - \psi]_+ = 1$, where $z = \tau_j s_{\cdot j}$ restricted to the visible set
$Q$. Write $F_Q(\psi) := \sum_{i\in Q}[z_i - \psi]_+$. For fixed $Q$, $F_Q$ is continuous,
non-increasing, and strictly decreasing wherever positive, so the solution of $F_Q(\psi)=1$ is
unique. Enlarging the set to $Q' = Q \cup \{i^\dagger\}$ adds a non-negative term pointwise, so
$F_{Q'}(\psi) \geq F_Q(\psi)$ for every $\psi$. Evaluating at the old solution gives
$F_{Q'}(\psi_j^{(t)}) \geq 1$, and since $F_{Q'}$ is non-increasing the solution of
$F_{Q'}(\psi) = 1$ is at least $\psi_j^{(t)}$. Hence $\psi_j^{(t+1)} \geq \psi_j^{(t)}$, and by
induction $\psi_j$ is non-decreasing along the prefix.

(ii) $p_{ij}^{(t)} = [z_i - \psi_j^{(t)}]_+$, so $p_{ij}^{(t)} = 0$ means
$z_i \leq \psi_j^{(t)}$. By (i), $\psi_j^{(t')} \geq \psi_j^{(t)} \geq z_i$ for $t' \geq t$,
whence $p_{ij}^{(t')} = 0$. The converse fails: $z_i > \psi_j^{(t)}$ does not imply
$z_i > \psi_j^{(t')}$, so an admitted query may be evicted.

(iii) The frozen variant assigns index $i$ the value it had when $i$ first became visible, i.e.\
at $t = i$, giving $p_{ij}^{\mathrm{frozen}} = [z_i - \psi_j^{(i)}]_+$. Since
$\psi_j^{(i)} \leq \psi_j^{(T)}$ by (i), we have
$p_{ij}^{\mathrm{frozen}} \geq p_{ij}^{(T)}$ pointwise, so
$p_{ij}^{(T)} > 0 \Rightarrow p_{ij}^{\mathrm{frozen}} > 0$ and the frozen support contains the
exact one. The inclusion may be strict, so relative to the exact prefix column the frozen variant
admits a superset and never drops a member: its error is one-sided in \emph{support}, which is
what (iii) asserts and what the composition argument of Prop.~\ref{prop:stagecomp} needs. We do
not claim it is one-sided in \emph{fidelity}: $P_j$ and $R_j$ are measured against $T_j$, not
against the exact support, and this proposition assumes no margin condition, so an extra
admitted index may be a target and precision may rise. Under Assumption~\ref{ass:margin} with
$\tau_j$ in \eqref{eq:interval}, where the exact support is $T_j$, the two coincide and the
frozen variant's extra admissions are exactly false positives.
\end{proof}

\medskip\noindent\textbf{Corollary~\ref{cor:joint} (restated).}\ \emph{Let Assumption~\ref{ass:margin} hold for every key and let the ground truths be consistent,
$K_i=\{j: i\in T_j\}$. If $\tau_j\in[\frac{1}{W_j+m_j\delta_j},\frac{1}{W_j})$ and $K \ge m_j$
for every $j$, and $\theta_i < \min_{j\,:\,i\in T_j} c_j(1-\tau_jW_j)/m_j$ for every $i$, then
$P_j=R_j=1$ on every column and $P_i=R_i=1$ on every row, all four at once.}

\begin{proof}[Proof of Cor.~\ref{cor:joint}]
We first record the weakest true edge. By Thm.~\ref{thm:recovery} the support of $\tilde A_{\cdot j}$ is exactly $T_j$, of size
$m_j$, so with $z = \tau_j s_{\cdot j}$ the sparsemax threshold is
$\psi_j = \big(\sum_{i \in T_j} z_i - 1\big)/m_j$ and $p_{ij} = z_i - \psi_j$ for
$i \in T_j$. The minimum over $T_j$ is attained at the smallest score, so writing
$s_{\min} := \min_{i \in T_j} s_{ij}$,
\begin{align*}
\min_{i \in T_j} p_{ij}
&= \tau_j s_{\min} - \frac{\tau_j\sum_{i \in T_j} s_{ij} - 1}{m_j}
= \frac{1}{m_j}\Big(1 - \tau_j\Big(\sum_{i\in T_j} s_{ij} - m_j s_{\min}\Big)\Big)
= \frac{1 - \tau_j W_j}{m_j},
\end{align*}
using $W_j = \sum_{i \in T_j}(s_{ij} - s_{\min})$ from Assumption~\ref{ass:margin}. This is
strictly positive because $\tau_j < 1/W_j$ by \eqref{eq:interval}. Multiplying by $c_j$, the
weakest true edge is $\min_{i \in T_j}\tilde A_{ij} = c_j(1-\tau_j W_j)/m_j$.

Since $A_{ij} = \tau_i[\tilde A_{ij} - \theta_i]_+$ with $\tau_i>0$ and $\theta_i \geq 0$,
$A_{ij}>0$ requires $\tilde A_{ij} > \theta_i \ge 0$, so
$\supp(A_{\cdot j}) \subseteq \supp(\tilde A_{\cdot j}) = T_j$. Equality holds iff
$A_{ij} > 0$ for every $i \in T_j$, i.e.\ iff $\theta_i < \tilde A_{ij}$ for every such $i$ ---
for which the hypothesis $\theta_i < \min_{j : i\in T_j} c_j(1-\tau_j W_j)/m_j$ is sufficient,
being a bound against the weakest true edge of every column that claims $i$. (It is not
necessary: a row could sit below its own true edges without being below the minimum over
columns.)

\emph{Joint attainment.} $K \geq m_j = k^\star$ gives, by Prop.~\ref{prop:tournament}, that the hierarchical
construction returns the global solution, so it suffices to argue for the latter. With
$\tau_j$ in \eqref{eq:interval}, Thm.~\ref{thm:recovery} gives
$\supp(\tilde A_{\cdot j}) = T_j$, hence $P_j = R_j = 1$ on the column before truncation
(Prop.~\ref{prop:printerval}). By the computation above the weakest true edge of column $j$ is
$c_j(1-\tau_j W_j)/m_j$, so $\theta_i$ strictly below the minimum of these over the columns
claiming $i$ leaves every $i \in T_j$ with $A_{ij} > 0$, while every entry already zero stays
zero; the column support is therefore unchanged and $P_j = R_j = 1$ after truncation as well.
For the row, consistency gives $K_i=\{j : i\in T_j\}$, so for $j\notin K_i$ we have $i\notin T_j$
and hence $\tilde A_{ij}=0$ by the column recovery just established; thus
$\max_{j\notin K_i}\tilde A_{ij}=0\le\theta_i$, while $\theta_i<\min_{j\in K_i}\tilde A_{ij}$ by
hypothesis. The row therefore separates --- it is not a further assumption --- and
Prop.~\ref{prop:graded}(ii) gives $P_i = R_i = 1$. All four hold under the single parameter
choice in the hypotheses. \emph{Consistency is used exactly once, here, and cannot be dropped}: an
inconsistent pair admits a key with $\tilde A_{ij}>0$ and $j\notin K_i$, which no $\theta_i$
below the true edges can remove.
\end{proof}
\section{Numerical verification of the analytical claims}
\label{app:numerics}

\paragraph{Protocol.} Unless a claim requires otherwise, a column is drawn by choosing $n_q$
uniformly from a stated range, choosing a target-set size $m_j$, and drawing scores so that
Assumption~\ref{ass:margin} holds by construction: targets receive scores in $[0,1)$ and
non-targets scores below $-\delta$ for a margin $\delta$ drawn uniformly from $[0.2,1.2)$. This
plants a known ground truth with a known positive margin, which is what makes support recovery
checkable rather than merely plausible. Claims that must hold for \emph{arbitrary} inputs
(Prop.~\ref{prop:stagecomp}) instead draw unstructured Gaussian scores for half the trials and
planted-margin scores for the other half, so that both the $P^{(1)}=1$ and $P^{(1)}<1$ branches
are exercised. \textbf{No block discards a column because the claim failed on it}, which is a
consequence of the sharp form of Thm.~\ref{thm:recovery}: two blocks previously sampled $\tau_j$
from a merely sufficient set and discarded the columns on which that set was empty, and once the
interval is known to be non-empty whenever $\delta_j>0$ both sample the interval itself.
\textbf{Three counts are nonetheless smaller than the number of columns drawn, and the tables show
it} ($10{,}098$, $10{,}604$ and $20{,}472$ against $12{,}000$, $12{,}000$ and $24{,}000$): those
rows test behaviour \emph{above} the upper endpoint $1/W_j$, which is $+\infty$ when $W_j=0$, so
a column with $m_j=1$ has no such regime and contributes nothing to that row while contributing
normally to every other. That is the test being undefined, not a draw being rejected, and we
report the counts that were actually run rather than the counts attempted. Exact-arithmetic claims
are checked exactly on integers and sets; floating-point claims use $10^{-9}$. Each block seeds
its own generator, so the program is deterministic and the table is reproduced exactly by running
it; total runtime is under $25$ seconds on one CPU core and the only dependency is
\texttt{numpy}. The last block checks App.~\ref{app:selective} and is reported there.

\paragraph{One check is about the device rather than the mechanism, and we separate it.} The unit
cap of \eqref{eq:rowstep1} is the one place where a floating-point reduction could have entered a
\emph{decision} rather than a value. As the remark after Prop.~\ref{prop:twostep} sets out, the
implementation binds on the relation's own mass excess \eqref{eq:excess} and projects onto
$\sum_jA^{\mathrm{sm}}_{ij}$, so the binding set is a function of in-relation terms alone and the
softmax reduction's error never reaches it; the excess is accumulated in double precision from
single-precision entries cast before subtracting, giving it no error of its own, and a row with an
empty relation has excess exactly $0.0$, so an empty relation cannot bind the cap on any kernel.
\textbf{We therefore report the kernel's own row-sum error $\delta$ as a statistic of the machine,
beside the checks and not inside them}, and a released implementation should do the same: the
guarantee is device-independent and the measurement of $\delta$ is what demonstrates that it had
to be made so. On the reference CPU, $\delta$ reaches $3.0\times10^{-5}$ at $n_k=8192$ and
$6.0\times10^{-5}$ at $16{,}384$, against $\approx10^{-6}$ for the pairwise reduction of the
deployment GPU --- a spread no fixed tolerance spans, which is why the criterion reads no row
total.

\textbf{A second device statistic, and it is the one that bounds what the implementation
delivers.} The projection that enforces the cap is itself computed in single precision, so it
cannot act on an excess smaller than its own arithmetic resolves; a row inside that
\emph{window} is left uncapped and keeps its excess. The window is a property of the device's
prefix reduction exactly as $\delta$ is a property of its softmax reduction: $1\times10^{-7}$ on
the reference CPU, $1.1\times10^{-6}$ at $n_k=8192$ and $2.0\times10^{-6}$ at $16{,}384$ on the
deployment GPU, and as much as $n_k\varepsilon/4$ on a strictly sequential fp32 scan. We measure
it by bisection on the target device before any run and refuse to start if it exceeds what the
invariants allow, so the statement the release makes is
$\sum_jA_{ij}\le\sum_jA^{\mathrm{sm}}_{ij}+w$ with $w$ measured and reported --- never that the
binding set is device-independent inside the window. \emph{Reporting both numbers is the point}:
a mechanism whose guarantee is checked in floating point owes the reader the size of the gap
between the program and the arithmetic that runs it.

